# Database (Supabase PostgreSQL)
# Gunakan Transaction Pooler (port 6543 + ?pgbouncer=true) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Gunakan Session Pooler / Direct Connection (port 5432) untuk migrasi Prisma (DIRECT_URL)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Session & Security
SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
COOKIE_NAME="sim_session"
COOKIE_SECURE=false

# App Setup
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Opsional: daftar origin tambahan dipisahkan koma (misal domain produksi/preview Frontend)
ALLOWED_ORIGINS=

# File storage ('local' untuk lokal, 'supabase' untuk deploy Vercel + Supabase Storage)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage/uploads
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="isi-service-role-key-supabase"
SUPABASE_STORAGE_BUCKET="ormawa-files"
MAX_UPLOAD_SIZE_MB=10

# Observability
LOG_LEVEL=info
